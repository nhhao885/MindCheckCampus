# MindCheck Campus 2.0 — Tệp mẫu cấu hình biến môi trường (.env.example)
# Sao chép thành tệp .env tại thư mục gốc dự án hoặc backend/.env khi triển khai thực tế.
# TUYỆT ĐỐI không commit khóa thật trong .env lên Git.

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# Cấu hình Môi trường & Cơ sở dữ liệu 2 Vùng
MINDCHECK_ENV=development
MINDCHECK_DB_PATH=app/mindcheck.db
MINDCHECK_SEED_DEMO=0
MINDCHECK_REQUIRE_STAFF_BEARER=0

# Cấu hình CORS
MINDCHECK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Mật khẩu khởi tạo tài khoản nhân sự (PBKDF2-HMAC-SHA256)
MINDCHECK_CTSV_PASSWORD=CtsvPass#2026
MINDCHECK_COUNSELOR1_PASSWORD=CounselorPass#2026
MINDCHECK_COUNSELOR2_PASSWORD=CounselorPass#2026
MINDCHECK_ADMIN_PASSWORD=AdminPass#2026
